FROM python:3.11-slim

WORKDIR /app
COPY detection/ ./detection/
COPY shared/ ./shared/

RUN pip install --no-cache-dir requests

CMD ["python3", "detection/engine.py", \
     "--api", "http://pipeline:8000", \
     "--poll-interval", "30", \
     "--pipeline-host", "pipeline", \
     "--pipeline-port", "9000"]
