FROM python:3.11-slim

WORKDIR /app
COPY pipeline/ ./pipeline/
COPY shared/ ./shared/

RUN pip install --no-cache-dir \
    fastapi uvicorn duckdb \
    numpy pandas

EXPOSE 8000 9000

CMD ["python3", "pipeline/server.py", \
     "--tcp-host", "0.0.0.0", \
     "--tcp-port", "9000", \
     "--http-host", "0.0.0.0", \
     "--http-port", "8000", \
     "--db-path", "/data/events.db"]
