FROM python:3.11-slim
WORKDIR /app
COPY pipeline/ ./pipeline/
RUN pip install --no-cache-dir \
    fastapi uvicorn duckdb \
    numpy pandas pyarrow pytz
EXPOSE 8000 9000
CMD ["python3", "pipeline/server_v2.py", \
     "--tcp-host", "0.0.0.0", \
     "--tcp-port", "9000", \
     "--http-host", "0.0.0.0", \
     "--http-port", "8000", \
     "--parquet-dir", "/data/parquet"]
