FROM python:3.11-slim
WORKDIR /app
COPY pipeline/ ./pipeline/
COPY integrations/threat_intel/ ./integrations/threat_intel/
COPY causal-engine/ ./causal-engine/
RUN pip install --no-cache-dir duckdb
ENV CORTEX_DB_PATH=/data/cortex.duckdb
ENV TEMPORAL_DB_PATH=/data/temporal_memory.duckdb
ENV THRESHOLDS_DB_PATH=/data/adaptive_thresholds.duckdb
ENV RESPONSE_DB_PATH=/data/autonomous_response.duckdb
# SAFETY: simulation mode by default -- decisions logged, no real
# action executed, until explicitly enabled after a real observation period.
ENV GHOSTIT_AUTONOMOUS_ACTIONS_ENABLED=false
RUN pip install --no-cache-dir \
    fastapi uvicorn duckdb \
    numpy pandas pyarrow pytz
EXPOSE 8000 9000
CMD ["python3", "pipeline/server_v2.py", \
     "--tcp-host", "0.0.0.0", \
     "--tcp-port", "9000", \
     "--http-host", "0.0.0.0", \
     "--http-port", "8000", \
     "--parquet-dir", "/data/parquet"]
