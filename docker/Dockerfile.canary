FROM python:3.11-slim

WORKDIR /app
COPY deception/canary/ ./deception/canary/
COPY deception/mtd/ ./deception/mtd/
COPY causal-engine/ ./causal-engine/
RUN pip install --no-cache-dir duckdb
ENV CORTEX_DB_PATH=/data/cortex.duckdb
ENV TEMPORAL_DB_PATH=/data/temporal_memory.duckdb

CMD ["python3", "deception/canary/server.py", \
     "--http-port", "8080", \
     "--pipeline-host", "pipeline", \
     "--pipeline-port", "9000"]
